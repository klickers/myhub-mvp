---
import { Icon } from "astro-icon/components"

interface Props {
	href: string
	// class?: string
	icon: string
	label: string
}

const { href, icon, label } = Astro.props
---

<a
	href={href}
	class="flex gap-1 items-center py-1 px-3 bg-white border border-gray-400 rounded-full duration-300 hover:bg-gray-100"
>
	<Icon name={icon} />{label}
</a>
