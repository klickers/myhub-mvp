---
import type { TaskNode } from "@/helpers/buildTaskTree"
import Task from "@/components/models/task/Task.astro"
import { format } from "date-fns"
import { Icon } from "astro-icon/components"

interface Props {
	tasks: TaskNode[]
	depth?: number
}
const { tasks, depth = 0 } = Astro.props
---

{
	tasks.map((task) => (
		<div>
			<tr
				class={
					"border-b border-gray-200" +
					(task.status === "inprogress"
						? " bg-yellow-50 hover:bg-yellow-100"
						: " hover:bg-gray-100")
				}
			>
				<td
					class={
						"pl-" +
						depth * 4 +
						" max-w-[400px]" +
						(depth == 0 && " font-medium")
					}
				>
					<span class="hover:underline hover:cursor-pointer">
						{task.name}
					</span>
				</td>
				<td>
					<span>{task.status}</span>
				</td>
				<td class="font-mono text-right">
					<span>{task.estimatedTime}</span>
				</td>
				<td class="font-mono text-right">
					<span>
						{task.deadline && format(task.deadline, "MM/dd/yy")}
					</span>
				</td>
				<td>
					<span>
						{task.tags.map((tag, index) => (
							<span class="mr-1">
								{tag.tag.name +
									(index < task.tags.length - 1 ? "," : "")}
							</span>
						))}
					</span>
				</td>
				<td>
					<span class="flex gap-2 justify-end">
						<button class="text-blue-400 hover:text-blue-600">
							<Icon name="mingcute:pencil-3-fill" />
						</button>
						<button class="text-red-300 hover:text-red-500">
							<Icon name="mingcute:delete-2-fill" />
						</button>
					</span>
				</td>
			</tr>
			{task.subtasks.length > 0 && (
				<Task
					tasks={task.subtasks}
					depth={depth + 1}
				/>
			)}
		</div>
	))
}
