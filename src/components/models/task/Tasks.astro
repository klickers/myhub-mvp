---
import type { TaskNode } from "@/helpers/buildTaskTree"
import Task from "@/components/models/task/Task.astro"

interface Props {
	tasks: TaskNode[]
}
const { tasks } = Astro.props
---

<table>
	<thead>
		<tr>
			<th>Task</th>
			<th>Status</th>
			<th>Est. Time</th>
			<th>Deadline</th>
			<th>Tags</th>
		</tr>
	</thead>
	<tbody>
		<Task
			tasks={tasks}
			depth={0}
		/>
	</tbody>
</table>
