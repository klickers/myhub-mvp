---
import type { Contract, Prisma } from "@/generated/prisma/client"
import { Icon } from "astro-icon/components"
import { formatUtcDateOnly } from "@/helpers/dateOnly"

type ContractWithGuild = Prisma.ContractGetPayload<{
	include: { guild: true }
}>

type Props =
	| {
			isGuild: true
			contract: Contract
	  }
	| {
			isGuild?: false
			contract: ContractWithGuild
	  }

const { isGuild = false, contract } = Astro.props

function formatStatus(status: Contract["status"]) {
	switch (status) {
		case "notstarted":
			return "Not started"
		case "inprogress":
			return "In progress"
		case "onhold":
			return "On hold"
		case "completed":
			return "Completed"
		case "archived":
			return "Archived"
		default:
			return status
	}
}

function getContractStatusStyle(status: Contract["status"]) {
	switch (status) {
		case "completed":
			return {
				card: "border-emerald-200/90 bg-emerald-50/80",
				badge: "bg-emerald-100 text-emerald-800",
			}
		case "inprogress":
			return {
				card: "border-yellow-200/90 bg-yellow-50/80",
				badge: "bg-yellow-100 text-yellow-800",
			}
		case "onhold":
			return {
				card: "border-gray-300/90 bg-gray-100/75",
				badge: "bg-gray-200 text-gray-700",
			}
		case "archived":
			return {
				card: "border-gray-200 bg-white/45 opacity-70",
				badge: "bg-gray-100 text-gray-500",
			}
		default:
			return {
				card: "border-gray-300/70 bg-white/65",
				badge: "bg-gray-100 text-gray-700",
			}
	}
}

const statusStyle = getContractStatusStyle(contract.status)
---

<div
	class={`card duration-300 hover:shadow-md ${isGuild ? statusStyle.card : ""}`}
>
	<div class="card__content p-2">
		<div class="flex justify-between items-center">
			<div class="flex min-w-0 gap-3 items-center">
				<a
					href={`/hall/contracts/${contract.slug}`}
					class="min-w-0 font-semibold leading-tight"
				>
					{contract.name}
				</a>
				{
					isGuild ? (
						<span
							class={`shrink-0 rounded-full px-2 py-0.5 text-[0.68rem] font-semibold uppercase leading-none ${statusStyle.badge}`}
						>
							{formatStatus(contract.status)}
						</span>
					) : null
				}
				{
					!isGuild && (contract as ContractWithGuild).guild ? (
						<div class="flex gap-1 items-center w-32">
							<div class="h-4 w-4 rounded-full bg-gray-300" />
							<a
								href={`/hall/guilds/${(contract as ContractWithGuild).guild!.slug}`}
								class="text-gray-600 text-xs"
							>
								{(contract as ContractWithGuild).guild!.name}
							</a>
						</div>
					) : null
				}
			</div>
			<p class="text-xs text-gray-600 flex items-center gap-1">
				<Icon name="mingcute:calendar-fill" />
				{formatUtcDateOnly(contract.dueDate)}
			</p>
		</div>
		<!-- <div class="mt-4 relative">
			<div class="h-2 w-full rounded-full bg-gray-200"></div>
			<div class="h-2 w-3/4 rounded-full bg-emerald-400 absolute top-0">
			</div>
		</div> -->
	</div>
</div>
