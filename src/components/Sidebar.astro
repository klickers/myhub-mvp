---
import { Icon } from "astro-icon/components"
import SessionPlayer from "@/components/models/session/SessionPlayer"

interface Props {
	path: string
}
const { path } = Astro.props

const isActive = (href: string) => {
	return href === "/"
		? path === "/"
		: path === href || path.startsWith(href + "/")
}

const links = [
	// { name: "Home", href: "/", icon: "mingcute:home-4-fill" },
	{ name: "Tasks", href: "/tasks", icon: "mingcute:list-check-2-fill" },
	{
		name: "Agenda",
		href: "/calendar/agenda",
		icon: "mingcute:calendar-week-fill",
	},
	{ name: "Deadlines", href: "/calendar", icon: "mingcute:calendar-2-fill" },
	{
		name: "Sessions",
		href: "/calendar/sessions",
		icon: "mingcute:time-fill",
	},
]

// Home - daily agenda
// weekly focus view (all tasks added by agenda for the week)

// Calendar - sort/group agenda view by Tag Group (default but can toggle)
// toggle view sprints
// toggle view items (tasks) with deadlines
// have side list of tag groups to view items by said groups?

// DB of tasks
// Tabs: Current, Completed, other statuses, Calendar?

// Notes
---

<div class="w-[220px] pr-6 fixed top-0">
	<aside class="py-4 px-2 border-r border-gray-200 h-screen space-y-10">
		<div class="space-y-0.5">
			{
				links.map((link) => (
					<a
						href={link.href}
						class={
							"flex items-center gap-2 uppercase text-sm font-semibold rounded-3xl py-1 px-2 hover:bg-gray-100" +
							(isActive(link.href) ? " bg-gray-100" : "")
						}
					>
						<Icon name={link.icon} />
						<span>{link.name}</span>
					</a>
				))
			}
		</div>
		<div class="px-2">
			<p class="text-xs uppercase font-semibold text-gray-400 mb-1">
				Timekeeper
			</p>
			<SessionPlayer
				client:load
				transition:persist
			/>
		</div>
	</aside>
</div>
