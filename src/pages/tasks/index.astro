---
import Layout from "@/layouts/Layout.astro"
import { TasksBreadcrumb } from "@/helpers/data/breadcrumbs"
import TagGroupHeader from "@/components/models/tag/TagGroupHeader"
import { actions } from "astro:actions"
import { TagType } from "@/generated/prisma/enums"

const initialTagGroups = await Astro.callAction(actions.tag.getByType, {
	type: TagType.group,
})
---

<Layout breadcrumbs={[TasksBreadcrumb]}>
	<div class="flex gap-6">
		<aside>
			<!-- <div id="tooltipTagGroups">
					<Icon
						name="mingcute:information-fill"
						class="text-gray-400"
					/>
				</div>-->
			<TagGroupHeader
				client:load
				initialGroups={initialTagGroups.data}
			/>
		</aside>
	</div>
</Layout>

