---
import TasksLayout from "@/layouts/TasksLayout.astro"
import prisma from "@/helpers/prisma"
import buildTaskTree from "@/helpers/buildTaskTree"
import Tasks from "@/components/models/task/Tasks"

const tasks = await prisma.task.findMany({
	include: {
		tags: {
			include: {
				tag: true,
			},
		},
	},
})
const taskTree = buildTaskTree(tasks)

const tags = await prisma.tag.findMany({
	where: { type: "group" },
	orderBy: { order: "asc" },
	include: {
		children: {
			orderBy: { order: "asc" },
		},
	},
})
---

<TasksLayout>
	<h1>All Tasks</h1>
	<Tasks
		client:load
		tasks={taskTree}
		tags={tags}
	/>
</TasksLayout>
