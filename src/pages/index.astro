---
import Errands from "@/components/models/task/Errands"
import DayCalendar from "@/components/DayCalendar"
import Layout from "@/layouts/Layout.astro"
import TimeGreeting from "@/components/TimeGreeting.astro"
import { HomeBreadcrumb } from "@/helpers/data/breadcrumbs"
import InspiringQuote from "@/components/InspiringQuote"
---

<!-- TODO: add focused experiments, e.g. January ones -->
<Layout breadcrumbs={[HomeBreadcrumb]}>
	<div class="flex gap-8">
		<div class="w-full">
			<TimeGreeting name="Catherine" />
			<div class="flex gap-4 mt-8">
				<div class="card">
					<div class="card__content">
						<h2>Calendar</h2>
						<DayCalendar client:load />
					</div>
				</div>
				<div class="card">
					<div class="card__content">Agenda</div>
				</div>
			</div>
		</div>
		<div class="w-[220px] flex-none">
			<div class="sticky top-14 space-y-4">
				<InspiringQuote client:load />
				<div class="card mt-6">
					<div class="card__content">
						<Errands client:load />
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
