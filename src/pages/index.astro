---
import Errands from "@/components/models/task/Errands"
import DayCalendar from "@/components/DayCalendar"
import Layout from "@/layouts/Layout.astro"
---

<!-- TODO: add focused experiments, e.g. January ones -->
<Layout>
	<div class="flex gap-8">
		<div class="w-full">
			<!-- TODO: change greeting and sentence based on time of day -->
			<h1 class="mb-3">Good morning, Catherine</h1>
			<p class="text-gray-600 ml-0.5">Today will be amazing.</p>
			<div class="flex gap-4 mt-8">
				<div class="card">
					<div class="card__content">
						<h2>Calendar</h2>
						<DayCalendar client:load />
					</div>
				</div>
				<div class="card">
					<div class="card__content">Agenda</div>
				</div>
			</div>
		</div>
		<div class="w-[220px] flex-none">
			<div class="sticky top-8 space-y-4">
				<div class="card">
					<div class="card__content">Inspiring Quote</div>
				</div>
				<div class="card">
					<div class="card__content">
						<Errands client:load />
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
