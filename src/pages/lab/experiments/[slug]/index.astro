---
import Layout from "@/layouts/Layout.astro"
import { Icon } from "astro-icon/components"
import { actions } from "astro:actions"
import Button from "@/components/Button.astro"
import SessionPlayButton from "@/components/models/session/SessionPlayButton"
import Tasks from "@/components/models/task/Tasks"
import PreviousSessions from "@/components/models/session/PreviousSessions.astro"
import { AlchemyLabBreadcrumb } from "@/helpers/data/breadcrumbs"
import { Status } from "@/generated/prisma/enums"

const experiment = await Astro.callAction(actions.experiment.getBySlug, {
	slug: Astro.params.slug as string,
	includeSessions: true,
	sessionsLimit: 5,
})
if (!experiment.data) return Astro.redirect("/lab")

const tasks = await Astro.callAction(actions.task.listByExperiment, {
	experimentId: experiment.data.id,
	includeSubtasks: true,
	status: ["notstarted", "inprogress", "onhold"],
})
const completedTasks = await Astro.callAction(actions.task.listByExperiment, {
	experimentId: experiment.data.id,
	includeSubtasks: true,
	status: ["completed"],
})
---

<Layout
	breadcrumbs={[
		AlchemyLabBreadcrumb,
		{
			name: experiment.data.name,
			href: Astro.url.pathname,
		},
	]}
>
	<div class="flex gap-8 min-h-screen">
		<div class="w-full">
			<div class="sticky top-14 float-right flex items-center gap-0.5">
				<SessionPlayButton
					itemType="experiment"
					itemId={experiment.data.id}
					client:load
				/>
				<a
					href={`/lab/experiments/${experiment.data.slug}/edit`}
					class="inline-block text-white p-1 rounded-sm bg-gray-950"
				>
					<Icon name="mingcute:settings-5-fill" />
				</a>
			</div>
			<!-- TODO: double click to edit experiment name -->
			<h1 class="mb-3">{experiment.data.name}</h1>
			<p>
				{
					experiment.data.description ?? (
						<em>Put a description here.</em>
					)
				}
			</p>
			<div class="mt-10">
				<!-- TODO: in progress, upcoming, on hold -->
				<div class="flex justify-between">
					<h2>Active Assignments</h2>
					<div>
						<Button
							href={`/tasks/create?experimentSlug=${experiment.data.slug}`}
							icon="mingcute:plus-fill"
							label="Add Assignment"
						/>
					</div>
				</div>
				<Tasks
					tasks={tasks.data ?? []}
					statuses={[
						Status.notstarted,
						Status.inprogress,
						Status.onhold,
					]}
					parentType="experiment"
					parentId={experiment.data.id}
					client:load
				/>
				<div class="h-1"></div>
				<Tasks
					tasks={completedTasks.data ?? []}
					statuses={[Status.completed]}
					parentType="experiment"
					parentId={experiment.data.id}
					client:load
				/>
			</div>
		</div>
		<div class="space-y-4 w-[220px] flex-none">
			<div class="sticky top-14">
				<h2>Previous Sessions</h2>
				<PreviousSessions sessions={experiment.data.sessions} />
			</div>
		</div>
	</div>
</Layout>
