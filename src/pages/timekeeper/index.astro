---
import PreviousSessions from "@/components/models/session/PreviousSessions.astro"
import SessionPlayer from "@/components/models/session/SessionPlayer"
import Layout from "@/layouts/Layout.astro"
import { actions } from "astro:actions"

const sessions = await Astro.callAction(actions.session.list, {})
---

<Layout
	breadcrumbs={[
		{
			icon: "mingcute:time-fill",
			name: "Timekeeper",
			href: "/timekeeper",
		},
	]}
>
	<div class="flex gap-8 min-h-screen">
		<div class="w-full">
			<div class="sticky top-14">
				<h2>Current Session</h2>
				<!-- TODO: allow easy play by guild, contract, task -->
				<div class="card">
					<div class="card__content">
						<SessionPlayer client:load />
					</div>
				</div>
			</div>
		</div>
		<div class="space-y-4 w-1/3 flex-none">
			<div>
				<h2>Previous Sessions</h2>
				{
					sessions.data && (
						<PreviousSessions
							sessions={sessions.data}
							timekeeper={true}
						/>
					)
				}
			</div>
		</div>
	</div>
</Layout>
