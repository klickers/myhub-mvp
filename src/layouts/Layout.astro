---
import "@/styles/global.css"
import Sidebar from "@/components/Sidebar.astro"
import { Icon } from "astro-icon/components"

type Breadcrumb = {
	icon?: string
	name: string
	href: string
}

interface Props {
	breadcrumbs: Breadcrumb[]
}

const path = Astro.url.pathname
const breadcrumbs = Astro.props.breadcrumbs || [{ name: "Home", href: "/" }]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width"
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.svg"
		/>
		<meta
			name="generator"
			content={Astro.generator}
		/>
		<title>MyHub</title>
	</head>
	<body class="bg-gray-50">
		<div class="flex w-full min-h-screen mb-10">
			<Sidebar
				path={path}
				transition:persist
			/>
			<div
				class="ml-[220px] w-full pb-8"
				transition:persist
			>
				<div
					class="text-sm fixed flex items-center bg-white pl-10 pr-8 py-3 w-full z-10 border-b border-gray-300"
				>
					{
						breadcrumbs.map((breadcrumb, index) => {
							const isLast = index === breadcrumbs.length - 1

							return (
								<div class="flex items-center">
									<a
										href={
											isLast ? undefined : breadcrumb.href
										}
										aria-disabled={isLast}
										class={
											"flex gap-1 items-center" +
											(isLast
												? " text-gray-400 pointer-events-none"
												: " text-gray-600 hover:underline")
										}
									>
										{breadcrumb.icon && (
											<Icon
												name={breadcrumb.icon}
												class="-mt-[1px]"
											/>
										)}
										<span>{breadcrumb.name}</span>
									</a>
									{index < breadcrumbs.length - 1 && (
										<span class="mx-2 text-gray-400">
											/
										</span>
									)}
								</div>
							)
						})
					}
				</div>
				<main class="mt-20 pl-10 pr-8"><slot /></main>
			</div>
		</div>
	</body>
</html>
