---
import "@/styles/global.css"
import Sidebar from "@/components/Sidebar.astro"
import GlobalSearch from "@/components/GlobalSearch"

import { ClientRouter } from "astro:transitions"
import { Icon } from "astro-icon/components"
import { ToastContainer } from "react-toastify"
import "react-toastify/dist/ReactToastify.css"

type Breadcrumb = {
	icon?: string
	name: string
	href: string
}

interface Props {
	breadcrumbs: Breadcrumb[]
}

const path = Astro.url.pathname
const breadcrumbs = Astro.props.breadcrumbs || [{ name: "Home", href: "/" }]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width"
		/>
		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.svg"
		/>
		<meta
			name="generator"
			content={Astro.generator}
		/>
		<title>My Hub</title>
		<ClientRouter />
	</head>
	<body class="min-h-screen">
		<div class="min-h-screen w-full">
			<ToastContainer
				client:load
				transition:animate="none"
				transition:persist
			/>
			<Sidebar
				path={path}
				transition:persist
			/>
			<div class="app-content">
				<header
					class="app-topbar"
					transition:persist
				>
					<nav
						class="app-breadcrumbs"
						aria-label="Breadcrumb"
					>
						{
							breadcrumbs.map((breadcrumb, index) => {
								const isLast = index === breadcrumbs.length - 1

								return (
									<div class="flex items-center">
										<a
											href={
												isLast
													? undefined
													: breadcrumb.href
											}
											aria-disabled={isLast}
											aria-current={
												isLast ? "page" : undefined
											}
											class={
												"flex gap-1 items-center whitespace-nowrap" +
												(isLast
													? " text-gray-400 pointer-events-none"
													: " text-gray-600 hover:underline")
											}
										>
											{breadcrumb.icon && (
												<Icon
													name={breadcrumb.icon}
													class="-mt-[1px] text-gray-500"
												/>
											)}
											<span>{breadcrumb.name}</span>
										</a>
										{index < breadcrumbs.length - 1 && (
											<span class="mx-2 text-gray-400">
												/
											</span>
										)}
									</div>
								)
							})
						}
					</nav>
				</header>
				<GlobalSearch
					client:load
					transition:persist
				/>
				<main class="px-8 pb-8 pl-10 pt-20"><slot /></main>
			</div>
		</div>
	</body>
</html>
