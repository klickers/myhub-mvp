---
import Layout from "@/layouts/Layout.astro"
import { TasksBreadcrumb } from "@/helpers/data/breadcrumbs"
import TagGroupHeader from "@/components/models/tag/TagGroupHeader"
import { TagType } from "@/generated/prisma/enums"
import prisma from "@/helpers/prisma"

const path = Astro.url.pathname
const isActive = (href: string) => {
	return href === "/" ? path === "/" : path === href // || path.startsWith(href + "/")
}

const links = [
	{ name: "All Tasks", href: "/tasks" },
	{ name: "Untagged", href: "/tasks/untagged" },
]

const initialTagGroups = await prisma.tag.findMany({
	where: { type: TagType.group },
	orderBy: { order: "asc" },
	include: {
		children: {
			orderBy: { order: "asc" },
		},
	},
})
---

<Layout breadcrumbs={[TasksBreadcrumb]}>
	<div class="flex gap-12 w-full items-start">
		<!-- TODO: make transition persist -->
		<aside class="sticky top-20 w-40 flex-none">
			<!-- <div id="tooltipTagGroups">
					<Icon
						name="mingcute:information-fill"
						class="text-gray-400"
					/>
				</div>-->
			<div class="mb-2">
				{
					links.map((link) => (
						<a
							href={link.href}
							class={
								"block mb-1 text-sm hover:underline" +
								(isActive(link.href) ? " underline" : "")
							}
							data-active={isActive(link.href)}
						>
							{link.name}
						</a>
					))
				}
			</div>
			<TagGroupHeader
				client:load
				initialGroups={initialTagGroups}
			/>
		</aside>
		<div>
			<slot />
		</div>
	</div>
</Layout>

