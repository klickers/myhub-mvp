generator client {
    provider   = "prisma-client"
    output     = "../src/generated/prisma"
    engineType = "client"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// ================================================
// Updated Schema
// ================================================

enum Status {
    notstarted
    archived
    inprogress
    onhold
    completed
}

model KeyValue {
    key   String @id
    value String
}

enum TagType {
    group
    tag
    subgroup
}

model Tag {
    id         Int     @id @default(autoincrement())
    name       String
    slug       String  @unique
    type       TagType
    order      Int
    visibility Boolean @default(true)

    parentId Int?
    parent   Tag?  @relation("TagHierarchy", fields: [parentId], references: [id])
    children Tag[] @relation("TagHierarchy")

    sessions Session[]
    tasks    Task[]
    agendas  Agenda[]

    @@index([parentId, order])
}

enum AgendaItemType {
    none
    tag
    task
}

model Agenda {
    id            Int     @id @default(autoincrement())
    scheduledTime Int?    @default(0) // in minutes
    status        Status  @default(notstarted)
    description   String?

    tagId  Int?
    tag    Tag?  @relation(fields: [tagId], references: [id])
    taskId Int?
    task   Task? @relation(fields: [taskId], references: [id])

    sessions Session[]
}

enum TaskParentType {
    none
    tag
    task

    // ARCHIVED
    contract
    experiment
    guild
}

model Task {
    id            Int            @id @default(autoincrement())
    name          String
    parentType    TaskParentType @default(contract)
    status        Status         @default(notstarted)
    estimatedTime Int?           @default(0) // in minutes
    // scheduled     Boolean        @default(false)
    // startDate     DateTime?
    deadline      DateTime?

    tagId        Int?
    tag          Tag?    @relation(fields: [tagId], references: [id])
    parentTaskId Int?
    parentTask   Task?   @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
    subtasks     Task[]  @relation("TaskHierarchy")
    showSubtasks Boolean @default(true) // whether to default show or hide

    sessions Session[]
    agendas  Agenda[]

    // ARCHIVED
    makeTimeType MakeTimeType?
    contractId   Int?
    experimentId Int?
    guildId      Int?
    contract     Contract?     @relation(fields: [contractId], references: [id])
    experiment   Experiment?   @relation(fields: [experimentId], references: [id])
    guild        Guild?        @relation(fields: [guildId], references: [id])
}

enum SessionItemType {
    none
    tag
    task

    // ARCHIVED
    guild
    contract
    experiment
    objective
}

model Session {
    id        Int             @id @default(autoincrement())
    itemType  SessionItemType @default(task)
    startTime DateTime
    endTime   DateTime?
    notes     String?
    notesJson Json?

    tagId  Int?
    tag    Tag?  @relation(fields: [tagId], references: [id])
    taskId Int?
    task   Task? @relation(fields: [taskId], references: [id])

    agendaId Int?
    agenda   Agenda? @relation(fields: [agendaId], references: [id])

    // ARCHIVED
    objectiveId  Int?
    guildId      Int?
    contractId   Int?
    experimentId Int?
    objective    Objective?  @relation(fields: [objectiveId], references: [id])
    guild        Guild?      @relation(fields: [guildId], references: [id])
    contract     Contract?   @relation(fields: [contractId], references: [id])
    experiment   Experiment? @relation(fields: [experimentId], references: [id])
}

// ================================================
// Adventure Schema
// ================================================

model Guild {
    id          Int     @id @default(autoincrement())
    name        String
    slug        String  @unique
    description String?
    status      Status  @default(inprogress)

    contracts Contract[]
    sessions  Session[]
    tasks     Task[]
}

model Contract {
    id          Int      @id @default(autoincrement())
    name        String
    slug        String   @unique
    description String?
    // startDate   DateTime
    dueDate     DateTime
    status      Status   @default(inprogress)
    guildId     Int?

    guild Guild? @relation(fields: [guildId], references: [id])

    tasks    Task[]
    sessions Session[]
}

enum MakeTimeType {
    highlight
    batch
}

model Category {
    id   Int    @id @default(autoincrement())
    name String
    slug String @unique

    experiments Experiment[]
}

model Experiment {
    id          Int      @id @default(autoincrement())
    name        String
    slug        String   @unique
    description String?
    status      Status   @default(inprogress)
    categoryId  Int?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    category Category? @relation(fields: [categoryId], references: [id])

    tasks    Task[]
    sessions Session[]
}

model DailyHighlight {
    date      DateTime @id @unique
    highlight String?
}

